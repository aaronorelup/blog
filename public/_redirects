# Posts moved from /posts/<slug>/ to /ledger/<slug>/ when the site took on the tea house
# design. AO-004 and AO-005 were syndicated under the old paths, so these stay forever.
/posts/* /ledger/:splat 301
/posts /ledger 301

# Courses became a section of the site on 2026-10-01: /course/ moved to /courses/<course>/.
# Cloudflare does not take the first matching rule when two wildcard rules overlap (a broad
# /course/* beat /course/lessons/*), so these never overlap: exact rules for the old index,
# one wildcard for lessons. The proof-of-concept lesson's new-path twin is a tiny redirect page
# (public/courses/the-hidden-curriculum/lessons/poc-00-01-the-hidden-curriculum/).
/course /courses/the-hidden-curriculum/ 301
/course/ /courses/the-hidden-curriculum/ 301
/course/index.html /courses/the-hidden-curriculum/ 301
/course/lessons/* /courses/the-hidden-curriculum/lessons/:splat 301

