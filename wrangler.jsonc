{
  "name": "aaronorelup-blog",
  "compatibility_date": "2026-08-01",

  // The site is static files. The one script, worker/media.js, exists because the asset server
  // answers a Range request with the whole file, so no video on the site could seek; it answers
  // byte ranges for video and audio and nothing else. Only the files run_worker_first names
  // reach it ("*" matches across folders); every other request is served as an asset first.
  "main": "worker/media.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*.mp4", "/*.m4v", "/*.webm", "/*.mov",
      "/*.mp3", "/*.m4a", "/*.aac", "/*.wav", "/*.ogg", "/*.oga", "/*.opus", "/*.flac",
      // Games load their own sound in one piece and never seek it.
      "!/games/*"
    ]
  }
}
