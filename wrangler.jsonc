{
  "name": "aaronorelup-blog",
  "compatibility_date": "2026-08-01",

  // The site is static files. The one script, worker/index.js, does three jobs: worker/media.js
  // answers byte ranges for video and audio (the asset server answers a Range request with the
  // whole file, so no video on the site could seek), worker/reads.js is the live reader counter at
  // /api/reads, and worker/stats.js serves the daily traffic snapshot at /api/stats. Only the
  // paths run_worker_first names reach it ("*" matches across folders); every other request is
  // served as an asset first, without running any code.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A path that matches no file gets dist/404.html (src/pages/404.astro) with status 404, from
    // the asset server itself; before 2026-10-22 it was a 404 with an empty body. The Worker's own
    // answers (byte ranges, /api/*) are unchanged: it still sees a 404 for a missing file.
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*.mp4", "/*.m4v", "/*.webm", "/*.mov",
      "/*.mp3", "/*.m4a", "/*.aac", "/*.wav", "/*.ogg", "/*.oga", "/*.opus", "/*.flac",
      "/api/*",
      // Games load their own sound in one piece and never seek it.
      "!/games/*"
    ]
  },

  // The reader counter's database (one table, worker/reads.sql), which also keeps the traffic
  // snapshot (worker/stats.sql; the cron creates those tables itself). Created 2026-10-17 through
  // the Cloudflare Developer Platform connection, not wrangler.
  "d1_databases": [
    { "binding": "DB", "database_name": "blog-reads", "database_id": "f3f7223c-1bd1-467e-8d85-4b4f7f9bce97" }
  ],

  // Per Cloudflare location, per key: reads per address per post, and stat lookups per address.
  "ratelimits": [
    { "name": "READS_LIMIT", "namespace_id": "1701", "simple": { "limit": 6, "period": 60 } },
    { "name": "STATS_LIMIT", "namespace_id": "1702", "simple": { "limit": 30, "period": 60 } }
  ],

  // The traffic snapshot is gathered by this cron, once a minute. The snapshot itself changes once
  // a day; the minute is because the free plan allows 10 ms of CPU per run, so each run does one
  // small step (one analytics query at most) and stops. A backfill of 30 days takes about two hours (the first day shows within minutes);
  // after that almost every run finds nothing to do and costs one small D1 read.
  "triggers": { "crons": ["* * * * *"] },

  // Where the numbers come from, for worker/stats.js. Not secrets: the zone (aaronorelup.com), the
  // Cloudflare account, and the Web Analytics site. The API token is the secret CF_ANALYTICS_TOKEN.
  "vars": {
    "STATS_ZONE": "05a0357d9b9837a590501e934b886ae7",
    "STATS_ACCOUNT": "d4d2707426a98d95ebd2a70357cc2f0a",
    "STATS_SITE": "8a8d2e6e818f49028f2cd730f85a00fb"
  },

  // Workers Logs: one line per request the script handles (URL, status, CPU and wall time, how it
  // ended), kept by Cloudflare and readable from the dashboard or the observability API. Off until
  // 2026-10-17, so when the analytics showed two requests killed for CPU there was nothing to read.
  "observability": { "enabled": true }
}
