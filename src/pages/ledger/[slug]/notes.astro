---
// /ledger/<slug>/notes/: the full making-of of a split post (src/content/notes/<slug>.md), listed exactly when its
// post is: the post view with variant notes (components/post/PostView.astro).
import PanelPage from '../../../layouts/PanelPage.astro';
import PostView from '../../../components/post/PostView.astro';
import { allPosts, notesBySlug, slugOf } from '../../../lib/content.js';

export async function getStaticPaths() {
  const notes = await notesBySlug();
  return (await allPosts()).filter((post) => notes.has(slugOf(post)))
    .map((post) => ({ params: { slug: slugOf(post) }, props: { post, note: notes.get(slugOf(post)) } }));
}

const { post, note } = Astro.props;
---
<PanelPage title={`${note.data.title} · Aaron Orelup`} description={note.data.summary} active="ledger"
  noindex={post.data.unlisted}>
  <PostView post={post} note={note} />
</PanelPage>
