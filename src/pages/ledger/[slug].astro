---
// /ledger/<slug>/: every post that isn't a draft. An unlisted one is built with noindex and no share card.
import { allPosts, slugOf } from '../../lib/content.js';
import PanelPage from '../../layouts/PanelPage.astro';
import PostView from '../../components/post/PostView.astro';

export async function getStaticPaths() {
  return (await allPosts()).filter((post) => !post.data.draft)
    .map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props;
const { title, summary, date, unlisted } = post.data;
---
<PanelPage title={`${title} — Aaron Orelup`} description={summary} active="ledger" noindex={unlisted} published={date}>
  <PostView post={post} />
</PanelPage>
