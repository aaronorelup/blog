---
import { research, slugOf } from '../../lib/content.js';
import PanelPage from '../../layouts/PanelPage.astro';
import ResearchView from '../../components/panel/ResearchView.astro';

export async function getStaticPaths() {
  return (await research()).map((doc) => ({ params: { slug: slugOf(doc) }, props: { doc } }));
}

const { doc } = Astro.props;
---
<PanelPage title={`${doc.data.title} — Aaron Orelup`} description={doc.data.summary} active="ledger">
  <ResearchView doc={doc} />
</PanelPage>
