---
// The research shelf: agent-era research documents, sequential RE-### ids.
// Same list chrome as the ledger; different root, different id prefix.
import PanelPage from '../../layouts/PanelPage.astro';
import { research, slugOf } from '../../lib/content.js';
import { ledgerOrder } from '../../lib/posts.js';
import { shortDate } from '../../lib/dates.js';

const docs = ledgerOrder(await research());
---
<PanelPage
  title="Research · Aaron Orelup"
  description="Standalone research documents. They're deeper and drier than ledger entries, written to be handed to an agent as much as read by a person."
  active="ledger"
>
  <div class="view">
    <h1 class="view-title">Research</h1>
    <p class="view-intro">Standalone research documents. They're deeper and drier than ledger entries, written to be handed to an agent as much as read by a person. Each carries its provenance and a raw-markdown link.</p>

    <div class="view-list">
      {docs.map((doc) => (
        <a href={`/research/${slugOf(doc)}/`} class="rs-row">
          <div class="rs-id">
            {doc.data.id}<br /><span class="rs-date">{shortDate(doc.data.date)}</span>
          </div>
          <div>
            <h2 class="rs-name">{doc.data.title}</h2>
            <p class="rs-sum">{doc.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</PanelPage>
