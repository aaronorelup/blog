---
// /now/<date>/: one snapshot of the Now page, kept at its date for good once a newer one takes over /now.
import PanelPage from '../../layouts/PanelPage.astro';
import NowView from '../../components/now/NowView.astro';
import { nowSnapshots } from '../../lib/content.js';
import { shortDate } from '../../lib/dates.js';

export async function getStaticPaths() {
  const snaps = await nowSnapshots();
  return snaps.map((snap) => ({ params: { date: snap.id }, props: { snap, snaps } }));
}

const { snap, snaps } = Astro.props;
---
<PanelPage
  title={`Now + Setup, ${shortDate(new Date(snap.id))} · Aaron Orelup`}
  description={snap.data.summary}
  active="now"
  view="now"
>
  <NowView snap={snap} snaps={snaps} dated />
</PanelPage>
