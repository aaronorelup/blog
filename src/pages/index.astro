---
// The homepage: a scroll-driven tea house scene (scripts/home/) with an overlay panel that grows out of whichever
// card you click. The panel shows the real pages' views, fetched when opened (scripts/home/overlay/), so the two
// can never drift apart. Its look is home.css on the tokens of tokens.css, right from first paint in either mode.
import ModeToggle from '../components/chrome/ModeToggle.astro';
import PanelChrome from '../components/chrome/PanelChrome.astro';
import Home from '../layouts/Home.astro';
---

<Home title="Aaron Orelup — the tea house">
<div id="scene-wrap" class="home-wrap">
  <div id="scene-viewport" class="home-viewport">
    <canvas id="home-scene-canvas" class="home-canvas" aria-hidden="true" role="presentation"></canvas>
    <nav id="stop-rail" class="home-rail" aria-label="Sections">
      <button type="button" class="home-dot" data-goto="0" aria-label="Garden"></button>
      <button type="button" class="home-dot" data-goto="1" aria-label="Projects"></button>
      <button type="button" class="home-dot" data-goto="2" aria-label="The ledger and courses"></button>
      <button type="button" class="home-dot" data-goto="3" aria-label="Who I am"></button>
      <button type="button" class="home-dot" data-goto="4" aria-label="On your way out"></button>
    </nav>
  </div>
  <ModeToggle />
  <div id="scene-flash" class="home-flash" aria-hidden="true"></div>

  <!-- The overlay. Hidden until a card grows into it. Its host starts empty: each view is fetched from its real
       page when opened and mounted fresh (scripts/home/overlay/). The card's colour sits on the page colour, as a
       standalone page's does, so nothing of the scene shows through; overflow clips, so a #heading moves only
       #panel-scroll. -->
  <div id="panel-screen" class="ov-screen" aria-hidden="true">
    <div id="panel-scrim" class="ov-scrim"></div>
    <div id="panel-card" class="ov-card">
      <PanelChrome overlay={true}>
        <div class="ov-host" data-panel-host></div>
      </PanelChrome>
    </div>
  </div>

  <main id="content" class="home-main">

    <section class="home-stop home-stop-top" data-wp="0" data-screen-label="0 garden">
      <div class="home-card home-card-hero">
        <div class="home-hero-row">
          <h1 class="home-h1">Aaron Orelup</h1>
          <button type="button" id="avatar" class="coin" aria-label="Aaron — give him a spin">
            <span id="avatar-toss" class="coin-toss">
              <span id="avatar-spin" class="coin-spin">
                <span id="coin-rim" class="coin-spin"></span>
                <span class="coin-face">
                  <img class="coin-img" src="/aaron.webp" alt="" width="512" height="512">
                </span>
                <span id="coin-back" class="coin-face coin-back">
                  <span id="coin-back-night" class="coin-night">
                    <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true" focusable="false" class="coin-svg">
                      <circle cx="50" cy="50" r="50" fill="#211F33"></circle>
                      <circle cx="50" cy="50" r="41" fill="none" stroke="#3A3550" stroke-width="2"></circle>
                      <circle cx="50" cy="47" r="26" fill="#3A3050" opacity="0.55"></circle>
                      <circle cx="50" cy="47" r="19" fill="#5A4331" opacity="0.7"></circle>
                      <rect x="37" y="34" width="26" height="30" rx="2" fill="#FFD892"></rect>
                      <rect x="41" y="38" width="18" height="22" rx="1" fill="#FFF0C8"></rect>
                      <rect x="33" y="30" width="34" height="5" rx="1.6" fill="#4A2F1C"></rect>
                      <rect x="34" y="63" width="32" height="4.6" rx="1.4" fill="#4A2F1C"></rect>
                      <rect x="31" y="68" width="38" height="4" rx="1.4" fill="#3B2416"></rect>
                      <path d="M37 34 V64 M63 34 V64 M50 34 V64" stroke="#8A5E28" stroke-width="1.5" opacity="0.55"></path>
                    </svg>
                  </span>
                  <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true" focusable="false" class="coin-svg">
                    <circle cx="50" cy="50" r="50" fill="#F6DFA8"></circle>
                    <circle cx="50" cy="50" r="41" fill="none" stroke="#E0C489" stroke-width="2"></circle>
                    <path d="M50 76 V54" stroke="#9A5F36" stroke-width="5.5" stroke-linecap="round" fill="none"></path>
                    <path d="M50 62 C50 54 42 50 37 46" stroke="#9A5F36" stroke-width="4" stroke-linecap="round" fill="none"></path>
                    <path d="M50 58 C52 50 60 47 65 43" stroke="#9A5F36" stroke-width="3.4" stroke-linecap="round" fill="none"></path>
                    <ellipse cx="34" cy="42" rx="13" ry="9" fill="#6E8B3D"></ellipse>
                    <ellipse cx="66" cy="39" rx="11" ry="7.5" fill="#8FAE55"></ellipse>
                    <ellipse cx="50" cy="31" rx="15" ry="10" fill="#8FAE55"></ellipse>
                    <ellipse cx="45" cy="27" rx="8" ry="5.5" fill="#A6C46A"></ellipse>
                    <path d="M33 76 h34 a4 4 0 0 1 -4 6 H37 a4 4 0 0 1 -4 -6 Z" fill="#7A5B52"></path>
                    <path d="M30 74 h40 v3.5 H30 Z" fill="#8A6A5E"></path>
                  </svg>
                </span>
              </span>
            </span>
          </button>
        </div>
        <p class="home-lede">Welcome to my tea house. Pull up a chair. Everything I learn about AI, I leave here for you, free.</p>
        <p class="home-lede">And don't worry about being behind. In AI the leaves change every month. Most of what I learned in six years is already gone, and what's in the pot this week is all you need. You're never more than a month behind.</p>
        <div class="home-hint-row">
          <p class="home-hint">Scroll or press ↓</p>
        </div>
      </div>
    </section>

    <section class="home-spacer" data-wp="1" data-screen-label="1 threshold" aria-hidden="true"></section>

    <section class="home-stop home-stop-left" data-wp="2" data-screen-label="2 alcove">
      <div class="home-card">
        <h2 class="home-h2 home-h2-spaced">Projects</h2>
        <div class="home-col">
          <p class="home-p">Learning is best done when you dive in head first and enjoy the process. In doing so, I have developed everything from an experiment into a new coding paradigm to a full AI-assisted learning platform.</p>
          <p class="home-p">Some are hosted for you to run in the browser, and the bigger ones you can run yourself from the repo. Have a look around.</p>
          <a class="home-btn home-btn-start" href="/projects">See the projects →</a>
        </div>
      </div>
    </section>

    <section class="home-stop home-stop-right" data-wp="3" data-screen-label="3 desk">
      <div class="home-card home-card-narrow">
        <h2 class="home-h2">The Ledger &amp; Courses</h2>
        <p class="home-p">My contribution to the painful learning curve of AI that we are all facing. The Ledger logs everything from mistakes to funny moments to aspirational ideas. The courses are the lessons I wish I'd had: short, narrated, and filed one at a time.</p>
        <div class="home-actions">
          <a class="home-btn" href="/ledger">Read the Ledger →</a>
          <a class="home-btn" href="/courses">Browse the courses →</a>
        </div>
      </div>
    </section>

    <section class="home-stop home-stop-right" data-wp="4" data-screen-label="4 tea room">
      <div class="home-card">
        <h2 class="home-h2">Right now</h2>
        <p class="home-p">Building two things. <b>Wallpaper Breaker</b> is my own Windows 11 live-wallpaper app, built so Claude can see every wallpaper it makes. <b>The Hidden Curriculum</b> is a course on what nobody teaches people who build with AI, and a new lesson goes up most mornings.</p>
        <p class="home-p">Sit down a minute. This corner changes the most, so it's the best snapshot of what I'm thinking about this month.</p>
        <a class="home-btn home-btn-more" href="/about">More about me →</a>
      </div>
    </section>

    <section class="home-stop" data-wp="5" data-screen-label="5 gate">
      <div class="home-card home-card-gate">
        <h2 class="home-h2">On your way out</h2>
        <p class="home-p">Feel free to text or email me if you are interested in what I do or want to collaborate.</p>
        <div class="home-contact">
          <a class="home-link" href="tel:+15106951134">(510) 695-1134</a>
          <a class="home-link" href="mailto:Aaronjorelup@gmail.com">Aaronjorelup@gmail.com</a>
        </div>
        <nav class="home-social" aria-label="Elsewhere">
          <a class="home-btn home-btn-social" href="https://github.com/aaronorelup" target="_blank" rel="noreferrer noopener">GitHub</a>
          <a class="home-btn home-btn-social" href="https://dev.to/aaron_orelup" target="_blank" rel="noreferrer noopener">DEV</a>
          <a class="home-btn home-btn-social" href="https://x.com/AaronOrelup" target="_blank" rel="noreferrer noopener">X</a>
          <a class="home-btn home-btn-social" href="https://www.linkedin.com/in/aaron-orelup/" target="_blank" rel="noreferrer noopener">LinkedIn</a>
        </nav>
        <p class="home-sign">Thanks for coming through. Mind the step.</p>
      </div>
    </section>

  </main>
</div>
</Home>

<script>
  import '../scripts/home/index.js';
</script>
