---
// The Hidden Curriculum's course page. Everything that changes as lessons are released (which are out,
// durations, the map's regions and which lessons are about AI) comes from
// src/data/courses/the-hidden-curriculum.json, which the course's publish tool regenerates from its
// curriculum.md; the lesson players themselves are static files under public/courses/the-hidden-curriculum/lessons/.
//
// The map IS the curriculum: a path from Start through the six districts to the Finish, each district holding
// its run of modules, each module its lessons. AI is not a district: lessons about AI sit in the district they
// belong to and carry a lantern. The site knows nothing about a visitor (no accounts), so nothing here may read
// like personal progress ("next up", "in progress"): it only says what has been released.
import PanelPage from '../../layouts/PanelPage.astro';
import Coin from '../../components/Coin.astro';
import LessonList from '../../components/courses/LessonList.astro';
import '../../styles/courses.css';
import { COURSES, fmtDuration, fmtMinutes } from '../../data/courses.js';

const course = COURSES.find((c) => c.slug === 'the-hidden-curriculum');
const d = course.data;
const feature = d.latest || d.first;
const start = d.first;
const modulesByN = Object.fromEntries(d.modules.map((m) => [m.n, m]));
const subtitle = (name) => {
  const rest = name.includes(':') ? name.split(':').slice(1).join(':').trim() : '';
  return rest.split(/\s+/).length >= 3 ? rest : '';
};
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const out = d.modules.flatMap((m) => m.lessons).filter((l) => l.status === 'published');
const avgMin = out.length ? Math.round(out.reduce((n, l) => n + l.duration, 0) / out.length / 60) : null;

const regions = d.regions.map((r) => {
  const mods = r.mods.map((n) => modulesByN[n]).filter(Boolean);
  const lessons = mods.flatMap((m) => m.lessons);
  return {
    ...r,
    mods,
    total: lessons.length,
    avail: lessons.filter((l) => l.status === 'published').length,
    ai: lessons.filter((l) => l.lantern).length,
    range: mods.length > 1 ? `Modules ${mods[0].n}–${mods[mods.length - 1].n}` : `Module ${mods[0]?.n}`,
    eyebrow: r.kind === 'start' ? 'Start here' : r.kind === 'finish' ? 'Finish' : `District ${r.n} of ${d.districtCount}`,
  };
});
const plural = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

const lockPath = 'M7 10V7a5 5 0 0 1 10 0v3M5.5 10h13a1 1 0 0 1 1 1v8.5a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1V11a1 1 0 0 1 1-1Z';
const chevPath = 'M5 8l7 7 7-7';
const faq = [
  ['Do I need to know how to code?', 'No. The lessons explain what things are and how they fit together. If you build with AI, or want to, that is the only prerequisite.'],
  ['Is this a tutorial series?', 'No. There are no steps to follow along with. Each lesson builds the mental model first, so when a tutorial (or your AI) tells you to do something, you already know what it is and why it matters.'],
  ['Why are most lessons locked?', 'They are being made in order, one at a time, and each one unlocks here the day it is released. A lock only means "not released yet".'],
  ['Where is the AI section?', 'There isn\'t one, on purpose. AI shows up in every district, so the lessons about it sit where they belong: coding agents with development environments, agents on git with Git, keys for agents with Trust. They carry a lantern on the map, and every other lesson says where AI shows up, when it does.'],
  ['Do I need an account to watch?', 'No. Every released lesson plays right here in the browser, with captions, chapters and a transcript, and there is no sign-up. That also means the site has no idea what you have watched; it only shows what has been released.'],
  ['How is each lesson made?', 'A crew of AI agents writes three versions of the script, picks and merges the best, fact-checks it, voices it with a narrator from the ElevenLabs voice library (a synthetic voice, different for every lesson), then animates and reviews it scene by scene. Every scene is animated in code; the title and end cards sit on one painted backdrop.'],
];
---

<PanelPage
  title="The Hidden Curriculum — a course by Aaron Orelup"
  description="What nobody taught you about building with AI, drawn as a map you can keep in your head. Short narrated lessons, released one at a time."
  active="courses"
  image="/media/the-hidden-curriculum/og.jpg"
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <!-- the course's chōchin lantern (engine/kit.js icon 'lantern'), drawn on a 24 grid -->
    <symbol id="hc-lantern" viewBox="0 0 24 24">
      <path d="M12 .6v2.3M12 21.1v2.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" />
      <ellipse cx="12" cy="12" rx="6.5" ry="7.9" fill="currentColor" fill-opacity=".28" stroke="currentColor" stroke-width="1.4" />
      <path d="M7.2 6.7Q12 7.4 16.8 6.7M5.9 9.4Q12 10.1 18.1 9.4M5.5 12Q12 12.7 18.5 12M5.9 14.6Q12 15.3 18.1 14.6M7.2 17.3Q12 18 16.8 17.3" stroke="currentColor" stroke-width="1" stroke-opacity=".6" fill="none" />
      <rect x="8.9" y="2.9" width="6.2" height="1.7" rx=".5" fill="currentColor" />
      <rect x="8.9" y="19.4" width="6.2" height="1.7" rx=".5" fill="currentColor" />
    </symbol>
    <symbol id="hc-lock" viewBox="0 0 24 24"><path d={lockPath} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></symbol>
    <symbol id="hc-chev" viewBox="0 0 24 24"><path d={chevPath} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
  </svg>

  <div class="hc">
    <nav class="hc-crumbs" aria-label="Breadcrumb"><a href="/courses">Courses</a><span aria-hidden="true">/</span><span aria-current="page">The Hidden Curriculum</span></nav>

    <section class="hc-hero">
      <div>
        <p class="cs-eyebrow">Course 1 · In production</p>
        <h1>The Hidden Curriculum</h1>
        <p class="hc-lede">What nobody taught you about building with AI: terminals, files, git, keys, hosting and the rest, drawn as a map you can keep in your head.</p>
        <p class="hc-sub">These aren't step-by-step tutorials. Each lesson tells you what a thing is, where it lives, what it connects to, and what will surprise you when you meet it, so the first time you do it for real is not the first time you've heard of it.</p>
        <div class="hc-stats">
          <div class="hc-stat"><b>{d.totalLessons}</b><span>lessons</span></div>
          <div class="hc-stat"><b>{d.moduleCount}</b><span>modules</span></div>
          <div class="hc-stat"><b>{d.districtCount}</b><span>districts</span></div>
          <div class="hc-stat"><b>{avgMin ? `~${avgMin}` : '3–6'}</b><span>minutes a lesson</span></div>
        </div>
        <p class="hc-avail">
          <span class="hc-dot" aria-hidden="true"></span>{d.publishedLessons} of {d.totalLessons} lessons available · {fmtMinutes(d.runtimeSeconds)} total · more coming soon
        </p>
        <div class="hc-cta">
          {start && <a class="cs-pill is-primary" href={start.url}>Start with lesson {start.id} →</a>}
          <a class="cs-pill" href="#curriculum">Browse the map ↓</a>
        </div>
      </div>

      {feature && (
        <a class="hc-feature" href={feature.url} aria-label={`Watch lesson ${feature.id}: ${feature.title}, ${fmtDuration(feature.duration)}`}>
          <img src="/courses/the-hidden-curriculum/engine/assets/teahouse-night.jpg" alt="" width="1920" height="1080" decoding="async" />
          <span class="hc-play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="rgb(240,192,106)" /></svg></span>
          <span class="hc-cap">
            <span><small>Latest lesson · {feature.id}</small><strong>{feature.title}</strong></span>
            <span class="hc-dur">{fmtDuration(feature.duration)}</span>
          </span>
        </a>
      )}
    </section>

    <details class="hc-how">
      <summary>
        <span>
          <span class="cs-eyebrow">How it works</span>
          <span class="hc-how-t">A framework, not a checklist</span>
          <span class="hc-how-hint">Lesson {start?.id ?? '00.01'} covers this too; open it if you'd rather read.</span>
        </span>
        <svg class="hc-chev" aria-hidden="true"><use href="#hc-chev" /></svg>
      </summary>
      <div class="hc-how-body">
        <p class="hc-intro">The confusing part of building with AI is rarely the code. It's the dozen things around it that everyone assumes you already know. This course hands them to you in an order that makes sense.</p>
        <div class="hc-three">
          <div class="hc-card">
            <p class="cs-eyebrow">A map, not a manual</p>
            <h3>Every idea gets a shelf</h3>
            <p>Six districts, walked in order: from the files on your own computer, out to the network, trust and shipping. Each lesson pins itself to the map, so new ideas land somewhere instead of piling up.</p>
          </div>
          <div class="hc-card">
            <p class="cs-eyebrow">Five questions, every lesson</p>
            <h3>The same shape each time</h3>
            <ol>
              <li>What is it?</li>
              <li>Where does it live?</li>
              <li>What is it like?</li>
              <li>What does it connect to?</li>
              <li>What will surprise you?</li>
            </ol>
          </div>
          <div class="hc-card">
            <p class="cs-eyebrow">Short, with a transcript</p>
            <h3>A few minutes each</h3>
            <p>Every lesson is animated and narrated, with captions, chapters, a transcript you can click to jump around, and an MP4 to keep.</p>
          </div>
        </div>
      </div>
    </details>

    <section class="hc-section hc-map" id="curriculum">
      <div class="hc-head">
        <div>
          <p class="cs-eyebrow">The map</p>
          <h2>Start, six districts, finish</h2>
          <p class="hc-intro">This is the whole course, in the order it's released. Start at Orientation, walk the six districts from your own computer out to the people using what you ship, and finish by building one real project. Open a module to see its lessons.</p>
        </div>
      </div>

      <div class="hc-lanterns">
        <svg class="hc-string" viewBox="0 0 330 74" aria-hidden="true" focusable="false">
          <path d="M6 10 Q165 44 324 10" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-width="1.2" />
          {[0, 1, 2, 3, 4, 5].map((i) => {
            const x = 36 + i * 51.6;
            const y = 10 + 34 * (1 - Math.pow((x - 165) / 159, 2)) * 0.5 + 3;
            return (
              <g class="hc-string-l" style={`--i:${i}`}>
                <circle cx={x} cy={y + 15} r="15" class="hc-string-glow" />
                <use href="#hc-lantern" x={x - 13} y={y} width="26" height="30" />
                <text x={x} y={y + 44} text-anchor="middle">{i + 1}</text>
              </g>
            );
          })}
        </svg>
        <div>
          <p class="cs-eyebrow">The lanterns</p>
          <p>AI isn't a district. It hangs over all six, like lanterns over the streets. The {d.lanternCount} lessons about AI sit inside the district they belong to and carry a lantern <svg class="hc-lan" aria-label="lantern" role="img"><use href="#hc-lantern" /></svg>: coding agents with development environments, agents on git with Git. Every other lesson also says where AI shows up, when it does.</p>
        </div>
      </div>

      <div class="hc-bar">
        <ul class="hc-legend" aria-label="Legend">
          <li><span class="hc-dot" aria-hidden="true"></span>Available</li>
          <li><svg class="cs-lock" aria-hidden="true"><use href="#hc-lock" /></svg>Not released yet</li>
          <li><svg class="hc-lan" aria-hidden="true"><use href="#hc-lantern" /></svg>About AI</li>
        </ul>
        <button type="button" class="hc-toggle" data-expand aria-pressed="false">Open every module</button>
      </div>

      <ol class="hc-trail">
        {regions.map((r) => {
          const single = r.kind !== 'district';
          const m0 = r.mods[0];
          return (
            <li class={`hc-stop is-${r.kind}${r.avail > 0 ? ' is-lit' : ''}`} id={`district-${r.id}`}>
              <span class="hc-marker" aria-hidden="true">{r.kind === 'district' ? r.n : ''}</span>
              <div class="hc-stop-head">
                <p class="cs-eyebrow">{r.eyebrow}</p>
                <h3>{r.name}</h3>
                <p class="hc-stop-q">{cap(r.q)}</p>
                <p class="hc-stop-meta">
                  <span>{r.range}</span>
                  <span>{plural(r.total, 'lesson')}</span>
                  {r.avail > 0 && <b>{r.avail} available</b>}
                  {r.ai > 0 && <span class="hc-ai"><svg class="hc-lan" aria-hidden="true"><use href="#hc-lantern" /></svg>{r.ai} about AI</span>}
                </p>
              </div>

              {single ? (
                <LessonList lessons={m0.lessons} id={`module-${m0.n}`} flat />
              ) : (
                <div class="hc-mods">
                  {r.mods.map((m) => {
                    const ai = m.lessons.filter((l) => l.lantern).length;
                    return (
                      <details class={`hc-module${m.filed > 0 ? ' is-lit' : ''}`} id={`module-${m.n}`} open={m.filed > 0}>
                        <summary>
                          <span class="hc-mod-n">{m.n}</span>
                          <span class="hc-mod-name">{m.short}{subtitle(m.name) && <small>{subtitle(m.name)}</small>}</span>
                          <span class="hc-mod-ai">{ai > 0 && <span class="hc-tip" data-tip={`${plural(ai, 'lesson')} about AI`}><svg class="hc-lan" aria-hidden="true"><use href="#hc-lantern" /></svg>{ai}<span class="sr-only"> about AI</span></span>}</span>
                          <span class="hc-mod-count">{m.filed > 0 ? `${m.filed} of ${m.lessons.length} available` : plural(m.lessons.length, 'lesson')}</span>
                          <span class="hc-mod-lock">{m.filed === 0 && <span class="hc-tip" data-tip="Not released yet"><svg class="cs-lock" aria-hidden="true"><use href="#hc-lock" /></svg><span class="sr-only">Not released yet</span></span>}</span>
                          <svg class="hc-chev" aria-hidden="true"><use href="#hc-chev" /></svg>
                        </summary>
                        <LessonList lessons={m.lessons} />
                      </details>
                    );
                  })}
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </section>

    <section class="hc-section hc-maker">
      <Coin src="/aaron.webp" label="Aaron Orelup: flip the coin" size={112} />
      <div>
        <p class="cs-eyebrow">Who's making this</p>
        <h2>Aaron Orelup</h2>
        <p>I have a degree in Information Systems and I still learned most of this by breaking things: a Python script saved as .txt, a terminal open in the wrong folder, work automations tied to my own accounts. Once I was building real tools with AI, I kept meeting words nobody had taught me. This is the map I wish someone had handed me.</p>
        <div class="hc-links">
          <a href="/ledger/the-missing-map/">How the first lesson was made →</a>
          <a href="/about">More about me →</a>
          <a href="/ledger">Read the Ledger →</a>
        </div>
      </div>
    </section>

    <section class="hc-section hc-faq">
      <p class="cs-eyebrow">Questions</p>
      <h2>What people ask about the course</h2>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}<svg class="hc-chev" aria-hidden="true"><use href="#hc-chev" /></svg></summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  </div>

  <!-- an address ending in #module-NN opens that module (a lesson page's "Next" link lands there), and
       the toggle opens or closes every module at once -->
  <script is:inline>
    (function () {
      function open(hash) {
        var el = hash && document.getElementById(decodeURIComponent(hash.slice(1)));
        if (el && el.tagName === 'DETAILS') el.open = true;
      }
      open(location.hash);
      addEventListener('hashchange', function () { open(location.hash); });
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="#module-"]');
        if (a) open(a.getAttribute('href'));
      });
      var btn = document.querySelector('[data-expand]');
      var mods = Array.prototype.slice.call(document.querySelectorAll('.hc-module'));
      function sync() {
        var all = mods.every(function (m) { return m.open; });
        btn.setAttribute('aria-pressed', all ? 'true' : 'false');
        btn.textContent = all ? 'Close every module' : 'Open every module';
      }
      if (btn) {
        btn.addEventListener('click', function () {
          var all = mods.every(function (m) { return m.open; });
          mods.forEach(function (m) { m.open = !all; });
          sync();
        });
        mods.forEach(function (m) { m.addEventListener('toggle', sync); });
        sync();
      }
    })();
  </script>
</PanelPage>
