---
// The page for an address that has no page: Astro writes dist/404.html, and the asset server sends it with status 404
// for any path that matches no file (wrangler.jsonc: assets.not_found_handling = "404-page").
//
// The picture is an analog chess clock drawn here, a few hundred bytes of SVG: the left side's
// minute hand has reached twelve and its flag has dropped; the right side has three minutes
// left and its hand is lifting its own flag. Analog clocks are set so time runs out at 6:00.
import PanelPage from '../layouts/PanelPage.astro';

// A point on a dial: clockwise degrees from twelve.
const at = (cx: number, cy: number, deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [+(cx + r * Math.sin(a)).toFixed(1), +(cy - r * Math.cos(a)).toFixed(1)];
};
const CY = 99;
const faces = [
  // Lost on time: 6:00 exactly, the flag hanging straight down from its pivot.
  { cx: 75, hour: 180, minute: 0, flag: [82, 70, 82, 84] },
  // Three minutes left: 5:57, the minute hand pushing the flag up.
  { cx: 165, hour: 178.5, minute: 342, flag: [172, 70, 158, 73] },
];
const ticks = (cx: number) =>
  Array.from({ length: 12 }, (_, i) => {
    const long = i % 3 === 0;
    const [x1, y1] = at(cx, CY, i * 30, long ? 25 : 27);
    const [x2, y2] = at(cx, CY, i * 30, 30);
    return { x1, y1, x2, y2, w: long ? 2 : 1.2 };
  });
---
<PanelPage
  title="Lost on time — Aaron Orelup"
  description="There is no page at this address."
  active="none"
  tagline=""
  noindex
>
  <div class="page">
    <p class="page-kicker">404 · Not found</p>
    <h1 class="page-title">Lost on time.</h1>
    <p class="page-lede">
      There is no page at this address. Its flag fell before a move was made.
    </p>
    <div class="page-rule"></div>

    <svg viewBox="0 0 240 150" width="240" height="150" role="img" aria-labelledby="clock-title" class="lost-clock">
      <title id="clock-title">A chess clock. The flag on the left side has fallen.</title>
      <rect x="58" y="34" width="34" height="18" rx="3" class="lost-cap" />
      <rect x="148" y="45" width="34" height="7" rx="2" class="lost-cap" />
      <rect x="16" y="52" width="208" height="94" rx="10" class="lost-case" />
      {faces.map((f) => {
        const [hx, hy] = at(f.cx, CY, f.hour, 16);
        const [mx, my] = at(f.cx, CY, f.minute, 27);
        return (
          <g>
            <circle cx={f.cx} cy={CY} r="33" class="lost-face" />
            {ticks(f.cx).map((t) => (
              <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-width={t.w} class="lost-tick" />
            ))}
            <line x1={f.flag[0]} y1={f.flag[1]} x2={f.flag[2]} y2={f.flag[3]} class="lost-flag" />
            <circle cx={f.flag[0]} cy={f.flag[1]} r="1.8" class="lost-pivot" />
            <line x1={f.cx} y1={CY} x2={hx} y2={hy} stroke-width="3" class="lost-hand" />
            <line x1={f.cx} y1={CY} x2={mx} y2={my} stroke-width="2" class="lost-hand" />
            <circle cx={f.cx} cy={CY} r="2.4" class="lost-hub" />
          </g>
        );
      })}
    </svg>

    <div class="pc-prose"><p>A game lost on time is lost. This one offers a draw anyway.</p></div>
    <p class="lost-draw">½–½?</p>
    <div class="pc-prose"><p><a href="/">Accept, and go home</a></p></div>
  </div>
</PanelPage>
