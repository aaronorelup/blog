---
// Shell for the homepage only: the scene owns its own chrome. It links site.css, as every panel page does
// (PanelPage.astro), so the overlay's views find every rule they need already here, and then its own home.css.
import '../styles/site.css';
import '../styles/home.css';
import Head from '../components/chrome/Head.astro';
import { shareImage } from '../lib/og/pages.js';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Aaron Orelup's tea house. Everything I learn about AI, free for you. You're never more than a month behind.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <Head title={title} description={description} image={await shareImage(Astro.url.pathname)} home />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
