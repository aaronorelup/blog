---
// The tea room's frame (/tea/): the shared Head, read through the SEO switch (src/data/tea.js teaSeo), its own
// stylesheet (styles/tea/tea.css on tokens.css, never site.css) and the one small module that marks the current
// chapter (scripts/tea/rail.js). The day/night switch lives in the rail. Everything renders and links without script.
import '../styles/tea/tea.css';
import Head from '../components/chrome/Head.astro';
import { teaSeo } from '../data/tea.js';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const seo = teaSeo();
---

<!doctype html>
<html lang="en" class="tea-root">
  <head>
    <Head title={title} description={description} noindex={seo.noindex} canonical={seo.canonical ?? undefined} />
    <slot name="head" />
  </head>
  <body class="tea">
    <slot />
    <script>
      import '../scripts/tea/rail.js';
    </script>
  </body>
</html>
