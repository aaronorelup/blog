---
// A standalone panel page: /stats, /ledger, /courses, /projects, /about, each course and lore page, each post and
// research document. Real pages: they render without JavaScript, search engines and RSS readers see them, and the
// homepage overlay fetches its views from them. The same panel that grows out of a homepage card, already open. Its
// view's module (views/<data-panel-view>.js, through mountView) runs once the page has parsed.
import '../styles/site.css';
import Head from '../components/chrome/Head.astro';
import ModeToggle from '../components/chrome/ModeToggle.astro';
import PanelChrome from '../components/chrome/PanelChrome.astro';
import { shareImage } from '../lib/og/pages.js';

interface Props {
  title: string;
  description?: string;
  // The lit nav item, a NAV key (src/data/site.js), or 'none'.
  active?: string;
  // The page's view, for its module (data-panel-view).
  view?: string;
  noindex?: boolean;
  // The share image (Head). Left out, a listed page that isn't a post shares the card drawn for its address
  // (lib/og/pages.js).
  image?: string;
  // A post's date (Head: og:type article).
  published?: Date;
  // A post's own title and its voice (Head: a listed post's structured data).
  headline?: string;
  voice?: string;
  // The footer's line after the copyright (PanelChrome's own line when left out).
  tagline?: string;
  // False on a page that brings its own <main> (/stats); PanelChrome's scrolling body is the landmark otherwise.
  main?: boolean;
}
const {
  title,
  description = "Aaron Orelup's notes on learning AI, filed as I go.",
  active = 'ledger',
  view,
  noindex = false,
  image,
  published,
  headline,
  voice,
  tagline,
  main,
} = Astro.props;
const card = image ?? (noindex ? undefined : await shareImage(Astro.url.pathname));
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} noindex={noindex} image={card} published={published}
      headline={headline} voice={voice} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#panel-scroll">Skip to content</a>
    <ModeToggle />
    <div id="panel-screen" class="pc-screen">
      <div id="panel-card" class="pc-card">
        <PanelChrome active={active} view={view} tagline={tagline} main={main}>
          <slot />
        </PanelChrome>
      </div>
    </div>
    <script>
      import { mountView } from '../scripts/views/index.js';
      const root = document.querySelector('[data-panel-view]');
      if (root) mountView(root);
    </script>
  </body>
</html>
