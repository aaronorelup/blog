---
// A standalone panel page: /stats, /ledger, /courses, /projects, /about, each course and lore page, each post and
// research document. Real pages: they render without JavaScript, search engines and RSS readers see them, and the
// homepage overlay fetches its post bodies from them. The same panel that grows out of a homepage card, already open.
import '../styles/site.css';
import Head from '../components/chrome/Head.astro';
import ModeToggle from '../components/chrome/ModeToggle.astro';
import PanelChrome from '../components/chrome/PanelChrome.astro';

interface Props {
  title: string;
  description?: string;
  // The lit nav item, a NAV key (src/data/site.js), or 'none'.
  active?: string;
  // The page's view, for its module (data-panel-view).
  view?: string;
  noindex?: boolean;
  image?: string;
  // The footer's line after the copyright (PanelChrome's own line when left out).
  tagline?: string;
}
const {
  title,
  description = "Aaron Orelup's notes on learning AI, filed as I go.",
  active = 'ledger',
  view,
  noindex = false,
  image,
  tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} noindex={noindex} image={image} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#panel-scroll">Skip to content</a>
    <ModeToggle />
    <div id="panel-screen" class="pc-screen">
      <div id="panel-card" class="pc-card">
        <PanelChrome active={active} view={view} tagline={tagline}>
          <slot />
        </PanelChrome>
      </div>
    </div>
  </body>
</html>
