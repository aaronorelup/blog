---
// Aaron's portrait as a coin you can flip, the same coin as on the homepage: hover makes it bob, a click
// tosses it and spins it a random number of half-turns. The reverse is the bonsai by day and the lit andon
// after dark. (The homepage's own coin lives in index.astro + home-scene.js, with its theme cross-fade and
// back door; this one only reads the panel's day/night mode.)
interface Props {
  src: string;
  label: string;
  size?: number;
}
const { src, label, size = 112 } = Astro.props;
---

<button type="button" class="coin" aria-label={label} style={`--coin-size:${size}px`}>
  <span class="coin-toss">
    <span class="coin-spin">
      <span class="coin-rim" aria-hidden="true"></span>
      <span class="coin-face coin-front"><img src={src} alt="" width="512" height="512" decoding="async" /></span>
      <span class="coin-face coin-back" aria-hidden="true">
        <svg class="coin-day" viewBox="0 0 100 100" focusable="false">
          <circle cx="50" cy="50" r="50" fill="#F6DFA8"></circle>
          <circle cx="50" cy="50" r="41" fill="none" stroke="#E0C489" stroke-width="2"></circle>
          <path d="M50 76 V54" stroke="#9A5F36" stroke-width="5.5" stroke-linecap="round" fill="none"></path>
          <path d="M50 62 C50 54 42 50 37 46" stroke="#9A5F36" stroke-width="4" stroke-linecap="round" fill="none"></path>
          <path d="M50 58 C52 50 60 47 65 43" stroke="#9A5F36" stroke-width="3.4" stroke-linecap="round" fill="none"></path>
          <ellipse cx="34" cy="42" rx="13" ry="9" fill="#6E8B3D"></ellipse>
          <ellipse cx="66" cy="39" rx="11" ry="7.5" fill="#8FAE55"></ellipse>
          <ellipse cx="50" cy="31" rx="15" ry="10" fill="#8FAE55"></ellipse>
          <ellipse cx="45" cy="27" rx="8" ry="5.5" fill="#A6C46A"></ellipse>
          <path d="M33 76 h34 a4 4 0 0 1 -4 6 H37 a4 4 0 0 1 -4 -6 Z" fill="#7A5B52"></path>
        </svg>
        <svg class="coin-night" viewBox="0 0 100 100" focusable="false">
          <circle cx="50" cy="50" r="50" fill="#211F33"></circle>
          <circle cx="50" cy="50" r="41" fill="none" stroke="#3A3550" stroke-width="2"></circle>
          <circle cx="50" cy="47" r="26" fill="#3A3050" opacity="0.55"></circle>
          <circle cx="50" cy="47" r="19" fill="#5A4331" opacity="0.7"></circle>
          <rect x="37" y="34" width="26" height="30" rx="2" fill="#FFD892"></rect>
          <rect x="41" y="38" width="18" height="22" rx="1" fill="#FFF0C8"></rect>
          <rect x="33" y="30" width="34" height="5" rx="1.6" fill="#4A2F1C"></rect>
          <rect x="34" y="63" width="32" height="4.6" rx="1.4" fill="#4A2F1C"></rect>
          <rect x="31" y="68" width="38" height="4" rx="1.4" fill="#3B2416"></rect>
          <path d="M37 34 V64 M63 34 V64 M50 34 V64" stroke="#8A5E28" stroke-width="1.5" opacity="0.55"></path>
        </svg>
      </span>
    </span>
  </span>
</button>

<style is:global>
  .coin {
    --coin-face: rgb(59, 46, 68); --coin-edge: rgb(90, 84, 112); --coin-rim-a: rgb(90, 84, 112); --coin-rim-b: rgb(70, 66, 90);
    flex: none; display: block; width: var(--coin-size); height: var(--coin-size); padding: 0; border: 0; background: transparent;
    cursor: pointer; perspective: 800px; border-radius: 50%;
  }
  :root[data-mode='day'] .coin { --coin-face: rgb(247, 201, 212); --coin-edge: rgb(58, 58, 66); --coin-rim-a: rgb(58, 58, 66); --coin-rim-b: rgb(74, 74, 80); }
  .coin-toss, .coin-spin, .coin-rim { position: absolute; inset: 0; transform-style: preserve-3d; }
  .coin-toss { position: relative; display: block; width: 100%; height: 100%; }
  .coin-face { position: absolute; inset: 0; box-sizing: border-box; border: 3px solid var(--coin-edge); border-radius: 50%; overflow: hidden; }
  .coin-front { background: var(--coin-face); transform: translateZ(7px); }
  .coin-front img { display: block; width: 118%; height: 118%; margin: -6% 0 0 -9%; object-fit: cover; pointer-events: none; }
  .coin-back { opacity: 0; transform: rotateY(180deg) translateZ(7px); background: #211F33; }
  .coin-back svg { display: block; width: 100%; height: 100%; }
  .coin-day { display: none !important; }
  :root[data-mode='day'] .coin-back { background: #F6DFA8; }
  :root[data-mode='day'] .coin-day { display: block !important; }
  :root[data-mode='day'] .coin-night { display: none !important; }
  @keyframes coin-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-7px) rotate(2deg); }
  }
  @keyframes coin-hop {
    0%   { transform: translate3d(0, 0, 0); }
    30%  { transform: translate3d(0, -26px, 130px); }
    52%  { transform: translate3d(0, -34px, 152px); }
    78%  { transform: translate3d(0, -12px, 62px); }
    100% { transform: translate3d(0, 0, 0); }
  }
</style>

<script>
  // Same toss as the homepage coin: stacked discs make the milled edge, and the faces are swapped by hand
  // from the turn angle, so it never depends on backface-visibility or depth sorting.
  function bindCoin(btn: HTMLElement) {
    const toss = btn.querySelector<HTMLElement>('.coin-toss');
    const spin = btn.querySelector<HTMLElement>('.coin-spin');
    const rim = btn.querySelector<HTMLElement>('.coin-rim');
    const front = btn.querySelector<HTMLElement>('.coin-front');
    const back = btn.querySelector<HTMLElement>('.coin-back');
    if (!toss || !spin || !rim || !front || !back) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (let i = -6; i <= 6; i++) {
      const d = document.createElement('span');
      const inset = Math.abs(i) > 4 ? 2 : 0;
      d.style.cssText = `position:absolute;inset:${inset}px;border-radius:50%;background:var(${i % 2 ? '--coin-rim-b' : '--coin-rim-a'});transform:translateZ(${i}px)`;
      rim.appendChild(d);
    }

    const show = (deg: number) => {
      const facing = Math.cos((deg * Math.PI) / 180);
      const edge = Math.abs(facing) < 0.06;
      front.style.opacity = !edge && facing > 0 ? '1' : '0';
      back.style.opacity = !edge && facing < 0 ? '1' : '0';
    };
    let turn = 0;
    let busy = false;
    show(0);

    btn.addEventListener('pointerenter', () => {
      if (!busy && !reduce) toss.style.animation = 'coin-bob 1.6s ease-in-out infinite';
    });
    btn.addEventListener('pointerleave', () => {
      if (!busy) toss.style.animation = '';
    });
    btn.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      const half = 3 + Math.floor(Math.random() * 5);    // odd counts land on the reverse
      const dur = reduce ? 420 : 1150;
      const from = turn, to = from + half * 180;
      toss.style.animation = '';
      void toss.offsetWidth;                             // restart cleanly on repeat clicks
      if (!reduce) toss.style.animation = `coin-hop ${dur}ms cubic-bezier(.32,.05,.36,1)`;
      const t0 = performance.now();
      const ease = (x: number) => 1 - Math.pow(1 - x, 2.6);
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        const deg = from + (to - from) * ease(p);
        spin.style.transform = `rotateY(${deg}deg)`;
        show(deg);
        if (p < 1) { requestAnimationFrame(tick); return; }
        turn = to % 360;
        toss.style.animation = '';
        busy = false;
      };
      requestAnimationFrame(tick);
    });
  }
  document.querySelectorAll<HTMLElement>('.coin').forEach(bindCoin);
</script>
