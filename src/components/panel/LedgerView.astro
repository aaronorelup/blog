---
// Moved to components/ledger/LedgerView.astro. index.astro imports this until T3.1 deletes it; until then the script
// below mounts the view's module in the homepage overlay, as T3.1's mountView will.
import LedgerView from '../ledger/LedgerView.astro';
---

<LedgerView {...Astro.props}><slot /></LedgerView>

<script>
  import { mount } from '../../scripts/views/ledger.js';
  mount(document.querySelector('[data-view="ledger"]'));
</script>
