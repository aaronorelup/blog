---
// The ledger index, as it appears both inside the homepage's overlay panel and on
// the standalone /ledger page. Markup and inline styles come straight from the design.
import { getCollection } from 'astro:content';
import { isListed } from '../../data/listed.js';

const all = await getCollection('posts', ({ data }) => isListed(data));
const posts = all.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.id.localeCompare(a.data.id),
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
  // Frontmatter dates are bare YYYY-MM-DD, which coerce to UTC midnight. Without
  // pinning the zone, a build west of UTC formats them a day early.
  timeZone: 'UTC',
});
const feedUrl = 'aaronorelup.com/rss.xml';
---

<div style="width:100%;max-width:1140px">
  <h1 style="margin:0 0 10px;font-family:'Zen Maru Gothic',sans-serif;font-size:clamp(30px,4vw,44px);line-height:1.1;font-weight:700;color:var(--pc-head);letter-spacing:-0.015em">The Ledger</h1>
  <p style="margin:0 0 40px;font-size:14px;line-height:1.75;color:var(--pc-quiet);max-width:680px">A running ledger of what I'm learning about AI — agents, automation, and whatever breaks along the way.</p>

  <div style="display:flex;flex-direction:column">
    {posts.map((post) => (
      <a
        href={`/ledger/${post.slug}/`}
        data-ledger-entry={post.slug}
        class="pc-row"
        style="display:grid;grid-template-columns:120px 1fr;gap:0 26px;padding:24px 14px;margin:0 -14px;border-top:1px solid var(--pc-line);border-radius:10px;text-decoration:none;cursor:pointer"
      >
        <div style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.7;color:var(--pc-accent)">
          {post.data.id}<br /><span style="color:var(--pc-quiet)">{dateFmt.format(post.data.date)}</span>
        </div>
        <div>
          <h2 style="margin:0 0 8px;font-family:'Zen Maru Gothic',sans-serif;font-size:20px;font-weight:700;color:var(--pc-strong);letter-spacing:-0.01em">{post.data.title}</h2>
          <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:15.5px;line-height:1.6;color:var(--pc-body);max-width:600px;text-wrap:pretty">{post.data.summary}</p>
        </div>
      </a>
    ))}
    {posts.length === 0 && (
      <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:16px;color:var(--pc-quiet)">No entries filed yet.</p>
    )}
  </div>

  <div style="margin:44px 0 60px;padding-top:22px;border-top:1px solid var(--pc-line);max-width:560px">
    <p style="margin:0 0 10px;font-size:13px;line-height:1.7;color:var(--pc-quiet);text-wrap:pretty">New entries show up in any reader app — no account, no algorithm, nothing recommended to you. Paste this into one:</p>
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <code style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;color:var(--pc-body);background:var(--pc-code);border:1px solid var(--pc-line);padding:6px 10px">{feedUrl}</code>
      <button type="button" id="feed-copy" class="pc-quiet-btn" style="font:inherit;font-size:12px;letter-spacing:0.06em;color:var(--pc-accent);background:none;border:0;padding:6px 0;cursor:pointer">copy</button>
    </div>
  </div>
</div>
