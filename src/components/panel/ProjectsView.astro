---
// Projects, as rendered in the overlay panel and on the standalone /projects page.
// Flagships get the long-form treatment; the rest are the click-and-play shelf.
import { PROJECTS } from '../../data/projects.js';

const flagships = PROJECTS.filter((p) => p.tier === 'flagship');
const rest = PROJECTS.filter((p) => p.tier !== 'flagship');

const shotBox = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block';
---

<div style="width:100%;max-width:1140px;padding-bottom:60px">
  <h1 style="margin:0 0 10px;font-family:'Zen Maru Gothic',sans-serif;font-size:clamp(30px,4vw,44px);line-height:1.1;font-weight:700;color:var(--pc-head);letter-spacing:-0.015em">Projects</h1>
  <p style="margin:0 0 42px;font-size:14px;line-height:1.75;color:var(--pc-quiet);max-width:680px">Things I've built and am building. The long-form projects are where most of my time goes: Wallpaper Breaker and The Hidden Curriculum have no public repo; Wordhord and LLM Monster Hunter run on your own machine, so the way in is the repo.</p>

  <section id="showreel" style="border-top:1px solid var(--pc-line2);padding:30px 0 44px;margin:0 0 10px">
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--pc-quiet);margin-bottom:14px">
      <span style="color:var(--pc-gold);letter-spacing:0.14em;text-transform:uppercase;white-space:nowrap">Showreel</span>
      <span style="width:14px;height:1px;background:var(--pc-line2);display:inline-block"></span>
      <span style="color:var(--pc-accent)">2026</span>
      <span style="width:14px;height:1px;background:var(--pc-line2);display:inline-block"></span>
      <span style="letter-spacing:0.08em;text-transform:uppercase">30 seconds, with sound</span>
    </div>
    <div style="position:relative;border:1px solid var(--pc-line);background:var(--pc-tile);aspect-ratio:16/9;overflow:hidden">
      <video controls playsinline preload="none" poster="/media/showreel/showreel-poster.webp" style="position:absolute;inset:0;width:100%;height:100%;display:block;background:#101220">
        <source src="/media/showreel/showreel-30.mp4" type="video/mp4" />
      </video>
    </div>
    <p style="margin:16px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:15px;line-height:1.6;color:var(--pc-soft);max-width:680px;text-wrap:pretty">Most of what's on this page, in thirty seconds. Every number in it is real and dated. The motion graphics and the music are code, rendered frame by frame from an HTML canvas timeline. There's also a <a href="/media/showreel/showreel-15.mp4" style="color:var(--pc-accent)">15-second cut</a>.</p>
  </section>

  <div style="display:flex;flex-direction:column;gap:0;margin:0 0 66px">
    {flagships.map((p) => (
      <article style="border-top:1px solid var(--pc-line2);padding:30px 0 44px">
        <div class="pc-flagship" style="display:grid;grid-template-columns:minmax(0,1.9fr) minmax(240px,300px);gap:0 40px;align-items:start">
          <div style="min-width:0">
            <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--pc-quiet);margin-bottom:14px">
              <span style="color:var(--pc-gold);letter-spacing:0.14em;text-transform:uppercase;white-space:nowrap">Long-form</span>
              <span style="width:14px;height:1px;background:var(--pc-line2);display:inline-block"></span>
              <span style="color:var(--pc-accent)">{p.year}</span>
              <span style="width:14px;height:1px;background:var(--pc-line2);display:inline-block"></span>
              <span style="letter-spacing:0.08em;text-transform:uppercase">{p.status}</span>
            </div>
            <h2 style="margin:0 0 8px;font-family:'Zen Maru Gothic',sans-serif;font-size:34px;line-height:1.1;font-weight:700;color:var(--pc-strong);letter-spacing:-0.02em">{p.name}</h2>
            <p style="margin:0 0 18px;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:18px;color:var(--pc-soft)">{p.tagline}</p>
            <p style="margin:0 0 26px;font-family:Georgia,'Times New Roman',serif;font-size:16.5px;line-height:1.62;color:var(--pc-body);max-width:600px;text-wrap:pretty">{p.blurb}</p>
            <div style="display:flex;flex-direction:column;gap:0;border-top:1px solid var(--pc-line)">
              {(p.highlights || []).map(([label, text]) => (
                <div style="display:flex;flex-direction:column;gap:6px;padding:14px 0;border-bottom:1px solid var(--pc-line)">
                  <div style="font-size:11.5px;line-height:1.5;color:var(--pc-strong);letter-spacing:0.1em;text-transform:uppercase">{label}</div>
                  <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:15px;line-height:1.55;color:var(--pc-soft);text-wrap:pretty">{text}</p>
                </div>
              ))}
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:16px">
            <div style="min-height:210px;position:relative;border:1px solid var(--pc-line);background:var(--pc-tile);overflow:hidden;display:flex;align-items:flex-end;padding:14px;box-sizing:border-box">
              {p.shot && <img src={p.shot} alt="" loading="lazy" decoding="async" width="640" height="420" style={shotBox} />}
              <span style="position:relative;font-size:10.5px;letter-spacing:0.14em;color:var(--pc-quiet);text-transform:uppercase">{p.shotLabel ?? 'No screenshot yet'}</span>
            </div>
            <p style="margin:0;font-size:11.5px;line-height:1.7;color:var(--pc-quiet)">{p.runsOn}</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              {p.tags.map((t) => (
                <span style="font-size:11.5px;letter-spacing:0.06em;color:var(--pc-soft);border:1px solid var(--pc-line2);border-radius:999px;padding:4px 10px">{t}</span>
              ))}
            </div>
            {p.cta ? (
              <a
                href={p.cta.href}
                data-ledger-entry={p.cta.ledger}
                data-no-fly={p.cta.ledger ? undefined : true}
                class="pc-source-btn"
                style="display:block;text-align:center;padding:12px 16px;border:1px solid var(--pc-accent);color:var(--pc-strong);font-size:13px;letter-spacing:0.08em;text-decoration:none"
              >{p.cta.label}</a>
            ) : p.href ? (
              <a
                href={p.href}
                target="_blank"
                rel="noreferrer noopener"
                class="pc-source-btn"
                style="display:block;text-align:center;padding:12px 16px;border:1px solid var(--pc-accent);color:var(--pc-strong);font-size:13px;letter-spacing:0.08em;text-decoration:none"
              >READ THE SOURCE ↗</a>
            ) : (
              <span style="display:block;text-align:center;padding:12px 16px;border:1px dashed var(--pc-line2);color:var(--pc-quiet);font-size:13px;letter-spacing:0.08em">REPO NOT PUBLIC YET</span>
            )}
            {p.noRepo && <p style="margin:0;font-size:11.5px;line-height:1.6;color:var(--pc-quiet);text-align:center;letter-spacing:0.04em">{p.noRepo}</p>}
          </div>
        </div>
      </article>
    ))}
  </div>

  <h3 style="margin:0 0 6px;font-size:12.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--pc-gold)">Playable in the browser</h3>
  <p style="margin:0 0 26px;font-size:13px;line-height:1.7;color:var(--pc-quiet);max-width:560px">Weekend-scale experiments. These you can just click.</p>

  <div style="display:flex;flex-direction:column;gap:34px">
    {rest.map((p) => (
      <article class="pc-shelf" style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:0 34px;align-items:stretch;border-top:1px solid var(--pc-line);padding:30px 0 0">
        <div style="display:flex;flex-direction:column;min-width:0">
          <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--pc-quiet);margin-bottom:12px">
            <span style="color:var(--pc-accent)">{p.year}</span>
            <span style="width:14px;height:1px;background:var(--pc-line2);display:inline-block"></span>
            <span style="letter-spacing:0.08em;text-transform:uppercase;white-space:nowrap">{p.status}</span>
          </div>
          <h2 style="margin:0 0 6px;font-family:'Zen Maru Gothic',sans-serif;font-size:25px;line-height:1.15;font-weight:700;color:var(--pc-strong);letter-spacing:-0.015em">{p.name}</h2>
          <p style="margin:0 0 14px;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:16px;color:var(--pc-soft)">{p.tagline}</p>
          <p style="margin:0 0 20px;font-family:Georgia,'Times New Roman',serif;font-size:16px;line-height:1.6;color:var(--pc-body);max-width:560px;text-wrap:pretty">{p.blurb}</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 22px">
            {p.tags.map((t) => (
              <span style="font-size:11.5px;letter-spacing:0.06em;color:var(--pc-soft);border:1px solid var(--pc-line2);border-radius:999px;padding:4px 10px">{t}</span>
            ))}
          </div>
          <div style="margin-top:auto;display:flex;gap:20px;align-items:center;flex-wrap:wrap;padding-bottom:4px">
            {p.href ? (
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noreferrer noopener' : undefined}
                class="pc-link"
                style="font-size:13px;letter-spacing:0.06em;color:var(--pc-strong);text-decoration:none;border-bottom:1px solid var(--pc-accent);padding-bottom:3px"
              >{p.external ? 'Play it ↗' : 'Play it →'}</a>
            ) : (
              <span style="font-size:13px;letter-spacing:0.06em;color:var(--pc-quiet)">Not public yet</span>
            )}
            {p.repo && (
              <a
                href={p.repo}
                target="_blank"
                rel="noreferrer noopener"
                class="pc-link-accent"
                style="font-size:13px;letter-spacing:0.06em;color:var(--pc-accent);text-decoration:none"
              >Read the source ↗</a>
            )}
            {p.post && (
              <a
                href={`/ledger/${p.post}/`}
                data-ledger-entry={p.post}
                class="pc-link-accent"
                style="font-size:13px;letter-spacing:0.06em;color:var(--pc-accent);text-decoration:none"
              >Read the write-up →</a>
            )}
          </div>
        </div>
        <div style="min-height:190px;position:relative;border:1px solid var(--pc-line);background:var(--pc-tile);overflow:hidden;display:flex;align-items:flex-end;padding:14px;box-sizing:border-box">
          {p.shot && <img src={p.shot} alt="" loading="lazy" decoding="async" width="640" height="420" style={shotBox} />}
          <span style="position:relative;font-size:10.5px;letter-spacing:0.14em;color:var(--pc-quiet);text-transform:uppercase">{p.shotLabel ?? 'No screenshot yet'}</span>
        </div>
      </article>
    ))}
  </div>
</div>
