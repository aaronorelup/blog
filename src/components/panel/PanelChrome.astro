---
// The panel's frame: a centred header with the nav, a scrolling body, and a footer.
// Shared by the homepage overlay and by the standalone /ledger, /courses, /projects, /about,
// course and post pages, so a card that grows open looks identical to a page loaded cold.
interface Props {
  // Which nav item is lit. A post lights "ledger"; a course page lights "courses".
  active?: 'ledger' | 'courses' | 'projects' | 'about';
  // The overlay can collapse back to the scene; a standalone page navigates home.
  overlay?: boolean;
}
const { active = 'ledger', overlay = false } = Astro.props;

const lit = (name: string) => (name === active ? 'var(--pc-head)' : 'var(--pc-quiet)');
---

<div id="panel-inner" style={`flex:1;min-height:0;display:flex;flex-direction:column;${overlay ? 'opacity:0;transition:opacity 320ms ease' : ''}`}>
  <header style="flex:none;display:flex;justify-content:center;padding:18px clamp(18px,4vw,44px);border-bottom:1px solid var(--pc-line)">
    <div style="width:100%;max-width:1140px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <a
        href="/"
        data-panel-home
        data-no-fly
        class="pc-home"
        style="display:flex;align-items:center;gap:9px;font:inherit;font-size:13.5px;letter-spacing:0.04em;white-space:nowrap;color:var(--pc-strong);text-decoration:none;padding:6px 0;cursor:pointer"
      >← Back to the tea house</a>
      <nav class={overlay ? '' : 'pc-navs'} style={`display:flex;gap:22px;font-size:13.5px;${overlay ? 'padding-right:88px' : ''}`}>
        <a href="/ledger" data-nav="ledger" class="pc-nav" style={`color:${lit('ledger')};text-decoration:none`}>Ledger</a>
        <a href="/courses" data-nav="courses" class="pc-nav" style={`color:${lit('courses')};text-decoration:none`}>Courses</a>
        <a href="/projects" data-nav="projects" class="pc-nav" style={`color:${lit('projects')};text-decoration:none`}>Projects</a>
        <a href="/about" data-nav="about" class="pc-nav" style={`color:${lit('about')};text-decoration:none`}>About</a>
      </nav>
    </div>
  </header>

  <div id="panel-scroll" style="flex:1;min-height:0;display:flex;justify-content:center;padding:34px clamp(18px,4vw,44px) 0;box-sizing:border-box;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--pc-line2) transparent">
    <slot />
  </div>

  <footer style="flex:none;display:flex;justify-content:center;padding:18px clamp(18px,4vw,44px);border-top:1px solid var(--pc-line)">
    <div style="width:100%;max-width:1140px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <p style="margin:0;font-size:12.5px;color:var(--pc-quiet)">© {new Date().getFullYear()} Aaron Orelup. Notes on learning AI, filed as I go.</p>
      <div style="display:flex;gap:20px;font-size:12.5px">
        <a href="/rss.xml" class="pc-foot" style="color:var(--pc-quiet);text-decoration:none">RSS</a>
        <a href="https://github.com/Bloodtailor" target="_blank" rel="noreferrer noopener" class="pc-foot" style="color:var(--pc-quiet);text-decoration:none">GitHub</a>
        <a href="https://dev.to/aaron_orelup" target="_blank" rel="noreferrer noopener" class="pc-foot" style="color:var(--pc-quiet);text-decoration:none">DEV</a>
        <a href="https://x.com/AaronOrelup" target="_blank" rel="noreferrer noopener" class="pc-foot" style="color:var(--pc-quiet);text-decoration:none">X</a>
        <a href="https://www.linkedin.com/in/aaron-orelup/" target="_blank" rel="noreferrer noopener" class="pc-foot" style="color:var(--pc-quiet);text-decoration:none">LinkedIn</a>
      </div>
    </div>
  </footer>
</div>
