---
// One research document. Same chrome as a ledger entry (PostView), with two
// research-specific additions: a provenance line and a raw-markdown link for agents.
import { renderEntry } from '../../lib/content.js';
import { shortDate } from '../../lib/dates.js';

const { doc } = Astro.props;
const { Content } = await renderEntry(doc);
---

<article data-post-article style="width:100%;max-width:720px;padding-bottom:60px">
  <a
    href="/research"
    data-no-fly
    class="pc-link-accent"
    style="display:inline-block;margin:0 0 30px;font-size:12.5px;letter-spacing:0.08em;color:var(--pc-accent);text-decoration:none"
  >← RESEARCH</a>

  <div style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.7;color:var(--pc-accent);margin-bottom:10px">
    {doc.data.id} <span style="color:var(--pc-quiet)">/ {shortDate(doc.data.date)}</span>
  </div>
  <h1 style="margin:0 0 14px;font-family:'Zen Maru Gothic',sans-serif;font-size:33px;line-height:1.2;font-weight:700;color:var(--pc-head);letter-spacing:-0.015em;text-wrap:pretty">{doc.data.title}</h1>
  <p style="margin:0 0 18px;font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.55;color:var(--pc-soft);text-wrap:pretty">{doc.data.summary}</p>
  {doc.data.provenance && (
    <p style="margin:0 0 12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;line-height:1.7;color:var(--pc-quiet);text-wrap:pretty">{doc.data.provenance}</p>
  )}
  {doc.data.raw && (
    <p style="margin:0 0 34px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;line-height:1.7">
      <a href={doc.data.raw} class="pc-link-accent" style="color:var(--pc-accent);text-decoration:none">raw markdown ↗</a>
      <span style="color:var(--pc-quiet)"> — hand this link to your agent</span>
    </p>
  )}
  <div style="height:1px;background:var(--pc-line);margin:0 0 34px"></div>

  <div class="pc-prose">
    <Content />
  </div>
</article>
