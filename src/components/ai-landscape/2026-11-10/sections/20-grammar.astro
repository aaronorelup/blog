---
// The nine layers, taught once, as HTML (SPEC 2.2): the closing line as the heading, the sentence someone might
// say, then the nine in their fixed order. Opening a layer's name shows what goes wrong without it and its term.
// 3D page: one layer shows at a time beside the neutral stack, and the chip rides the thread (sections/grammar.js).
import '../../../../styles/ai-landscape/2026-11-10/frame.css';
import Glyph from '../Glyph.astro';
import { COPY } from '../data/copy.js';
import { view } from '../data/view.js';

const terms = view.data.architecture.vocabulary;
const starts = (t, l) => t.term.toLowerCase().startsWith(l.name.toLowerCase());
// a layer's term: the vocabulary entry named after it, else the first one filed under that layer
const layers = view.layers.map((l) => ({ ...l, term: terms.find((t) => t.layer === l.id && starts(t, l)) || terms.find((t) => t.layer === l.id) || null }));
const first = layers[0];
const last = layers[layers.length - 1];
const rail = `${first.n} ${first.name} – ${last.n} ${last.name}`;
---
<section id="layers" class="ail-sec ail-gram" data-sec="grammar" data-screens="4.1" data-land="0.5" data-rail={rail} aria-labelledby="layers-title">
  <div class="ail-stage">
    <h2 id="layers-title" class="ail-gram__close ail-sentence">{COPY.grammar.close}</h2>
    <p class="ail-gram__ask ail-sentence">{COPY.grammar.request}</p>
    <ol class="ail-gram__list">
      {layers.map((l, i) => (
        <li class="ail-layer" data-i={i} data-layer={l.id}>
          <details class="ail-layer__d" name="ail-layer">
            <summary class="ail-layer__head">
              <Glyph name={l.id} /><span class="ail-layer__n ail-label">{l.n}</span><span class="ail-layer__name ail-title">{l.name}</span>
            </summary>
            <div class="ail-layer__more">
              <p>{l.without}</p>
              {l.term && <p><dfn class="ail-label">{l.term.term}</dfn> {l.term.definition}</p>}
            </div>
          </details>
          <p class="ail-layer__say ail-sentence">{l.sentence}</p>
        </li>
      ))}
    </ol>
    <p class="ail-gram__chip" aria-hidden="true">{layers.map((l) => <Glyph name={l.id} />)}</p>
  </div>
</section>
