---
// Provider-agnostic design (SPEC 2.9.4): twenty lamps, five companies by four questions, lit, half lit or dark.
// Text version: a real table with the answer in words and a lamp beside it, then the plumbing that makes swaps work.
// 3D page (sections/agnostic.js): the lamps lie on a glass board in front of the stacks, one column per company.
import '../../../../styles/ai-landscape/2026-11-10/architecture.css';
import Fact from '../Fact.astro';
import { COPY } from '../data/copy.js';
import { fact, view } from '../data/view.js';

const G = view.data.architecture.agnostic;
const COLS = [['backsStandards', COPY.architecture.standards], ['harnessRunsOthers', COPY.architecture.runsOthers], ['planTravels', COPY.architecture.planTravels], ['modelsElsewhere', COPY.architecture.elsewhere]];
const SAY = { yes: COPY.architecture.yes, partial: COPY.best.partly, no: COPY.architecture.no };
const rows = G.matrix.map((m) => ({ id: m.provider, name: view.provider(m.provider).name, cells: COLS.map(([k]) => ({ key: k, value: m[k].value, fact: fact(m[k].claim) })) }));
---
<section id="agnostic" class="ail-sec ail-agn" data-sec="agnostic" data-kind="board" data-screens="0.7" data-land="0.35" data-rail={G.claim.short} aria-labelledby="agnostic-title">
  <div class="ail-stage">
    <h2 id="agnostic-title" class="ail-agn__claim ail-sentence"><Fact fact={fact(G.claim)} /></h2>
    <table class="ail-agn__board">
      <thead>
        <tr><td></td>{COLS.map(([k, w]) => <th scope="col" class="ail-agn__q ail-label" data-col={k}>{w}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="ail-agn__row" data-p={r.id}>
            <th scope="row" class="ail-agn__p ail-label">{r.name}</th>
            {r.cells.map((c) => (
              <td class="ail-agn__cell" data-v={c.value} data-col={c.key}>
                <Fact fact={c.fact} full tag={false}><span class="ail-lampx" data-v={c.value} aria-hidden="true"></span><span class="ail-agn__w">{SAY[c.value]}</span></Fact>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="ail-agn__key ail-label">
      {Object.entries(SAY).map(([v, w]) => <span><span class="ail-lampx" data-v={v} aria-hidden="true"></span>{w}</span>)}
    </p>
    <details class="ail-agn__more">
      <summary class="ail-ar-more"><svg class="ail-ar-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.5M12 12h.5M19 12h.5" /></svg><span class="ail-ar-morew ail-label">{G.plumbing.length} {COPY.world.more}</span></summary>
      <ul class="ail-agn__plumb ail-card">
        {G.plumbing.map((x) => <li><b>{x.name}</b> {x.what} <Fact fact={fact(x.claim)} full>{fact(x.claim).short}</Fact></li>)}
      </ul>
    </details>
  </div>
</section>
