---
// The router idea (SPEC 2.9.3): three ways to talk to agents, the last with no line from you to the worker, and
// what it costs, in the essay's own numbers with its date. Text version: three small diagrams with their limits.
// 3D page (sections/router.js): the same three drawn in ink on the floor, one lit at a time, the cut line snipped.
import '../../../../styles/ai-landscape/2026-11-10/architecture.css';
import Fact from '../Fact.astro';
import { COPY } from '../data/copy.js';
import { fact, thing, view } from '../data/view.js';

const R = view.data.architecture.routerPattern;
const OFFICIAL = { yes: COPY.links.official, partial: COPY.links.partial, no: COPY.links.unofficial };
const essay = R.sources[0];
const rule = fact(R.rules[0]);
const caveat = fact(R.caveats[0]);
// the text version's diagram: you on the left, the one you talk to first in the middle, the rest on the right
function figure(shape) {
  const ids = [...new Set(shape.edges.flatMap((e) => [e.source, e.target]))];
  const at = Object.fromEntries(ids.map((id, i) => [id, [id === 'you' ? 16 : i === 1 ? 82 : 146, 46]]));
  return shape.edges.map((e) => {
    const [x1, y1] = at[e.source], [x2, y2] = at[e.target];
    const far = Math.abs(x2 - x1) > 100;
    const back = e.kind === 'reports' ? 7 : 0;
    return { kind: e.kind, d: far ? `M${x1} ${y1 - 6}Q${(x1 + x2) / 2} ${y1 - 52} ${x2} ${y2 - 6}` : `M${x1} ${y1 + back}L${x2} ${y2 + back}` };
  }).concat(ids.map((id) => ({ node: id, x: at[id][0], y: at[id][1] })));
}
const chips = R.shipped.map((s) => ({ r: thing(s.routerRef), w: thing(s.workerRef), official: s.official }));
---
<section id="router" class="ail-sec ail-rt" data-sec="router" data-screens="1.0" data-land="0.5" data-rail={R.name} aria-labelledby="router-title">
  <div class="ail-stage">
    <h2 id="router-title" class="ail-rt__title ail-title">{R.name}</h2>
    <ol class="ail-rt__shapes">
      {R.shapes.map((s, i) => (
        <li class="ail-rt__shape" data-i={i} data-edges={JSON.stringify(s.edges.map((e) => [e.source, e.target, e.kind]))}>
          <button type="button" class="ail-rt__name ail-label" aria-pressed="false">{s.name}</button>
          <svg class="ail-rt__fig" viewBox="0 0 162 72" aria-hidden="true" focusable="false">
            {figure(s).map((p) => (p.node
              ? (p.node === 'you' ? <circle cx={p.x} cy={p.y} r="6" /> : <rect x={p.x - 9} y={p.y - 9} width="18" height="18" rx="3" />)
              : <path class={`is-${p.kind}`} d={p.d} />))}
          </svg>
          <p class="ail-rt__limit">{s.limit}</p>
        </li>
      ))}
    </ol>
    <div class="ail-rt__more">
      <p class="ail-rt__rule ail-sentence"><Fact fact={rule} /></p>
      <p class="ail-rt__cav"><Fact fact={caveat} /></p>
      <details class="ail-rt__src">
        <summary class="ail-label">{essay.org} &middot; {essay.form} &middot;{' '}<time datetime={essay.date}>{essay.date}</time></summary>
        <div class="ail-rt__card ail-card">
          <table class="ail-rt__costs">
            <tbody>
              {R.costs.slice(0, 4).map((c) => (
                <tr><th scope="row">{c.what}</th><td class="ail-label">{c.score}</td><td>{c.note}</td></tr>
              ))}
            </tbody>
          </table>
          <ul class="ail-rt__list">
            {R.rules.slice(1).map((r) => <li><Fact fact={fact(r)} /></li>)}
            {R.caveats.slice(1).map((c) => <li><Fact fact={fact(c)} /></li>)}
          </ul>
          <ul class="ail-rt__list ail-rt__srcs">
            {R.sources.map((s) => <li><span class="ail-label">{s.org} &middot; {s.form} &middot; {s.date}</span> {s.title}</li>)}
          </ul>
        </div>
      </details>
      <ul class="ail-rt__chips">
        {chips.map((c) => (
          <li class="ail-rt__chip" data-official={c.official} title={`${c.r.name}, ${c.w.name}: ${OFFICIAL[c.official]}`}>
            <span class="ail-rt__end" data-owner={c.r.owner}></span><span class="ail-rt__wire"></span><span class="ail-rt__end" data-owner={c.w.owner}></span>
            <span class="ail-rt__cw">{c.r.name}, {c.w.name}: {OFFICIAL[c.official]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
