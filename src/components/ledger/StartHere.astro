---
// Five posts to read first (src/data/picks.js START_HERE): icon, title and stamp each (PostCard).
import PostCard from './PostCard.astro';

const { posts } = Astro.props;
---

<section class="start" aria-labelledby="start-title">
  <h2 class="eyebrow" id="start-title">Start here</h2>
  <ol class="start-cards">
    {posts.map((post) => <PostCard post={post} size={72} />)}
  </ol>
</section>
