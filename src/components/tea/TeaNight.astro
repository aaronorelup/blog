---
// The hero's painted backdrop in SVG and CSS only: the tea house at night under a moon, its shoji lit, a stone lantern
// glowing on the path, cherry trees either side. Colours are classes (styles/tea/cover.css), so day mode shifts it
// to an earlier, bluer evening. It is the static hero for good: what reduced motion and no WebGL keep.
const STARS = [
  [112, 64, 1.3], [205, 148, 0.9], [318, 52, 1.1], [402, 118, 0.8], [486, 36, 1.4], [575, 96, 0.9], [668, 40, 1],
  [742, 132, 0.8], [828, 70, 1.2], [905, 28, 0.9], [990, 112, 1.1], [1064, 58, 0.8], [1408, 160, 1], [1490, 92, 1.3],
  [1552, 196, 0.8], [60, 196, 0.9], [262, 230, 0.8], [1520, 30, 1], [700, 188, 0.7], [1130, 150, 0.9], [1340, 40, 0.8],
];
// one shoji bay: x, width
const BAYS = [[392, 128], [528, 128], [664, 128], [808, 128], [944, 128], [1080, 128]];
---

<svg class="tn" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="tn-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="tn-sky-top" />
      <stop offset="0.62" class="tn-sky-mid" />
      <stop offset="1" class="tn-sky-low" />
    </linearGradient>
    <radialGradient id="tn-moonglow">
      <stop offset="0" class="tn-glow-in" />
      <stop offset="1" class="tn-glow-out" />
    </radialGradient>
    <radialGradient id="tn-houseglow" cx="0.5" cy="0.62" r="0.55">
      <stop offset="0" class="tn-warm-in" />
      <stop offset="1" class="tn-warm-out" />
    </radialGradient>
    <radialGradient id="tn-lampglow">
      <stop offset="0" class="tn-lamp-in" />
      <stop offset="0.4" class="tn-lamp-mid" />
      <stop offset="1" class="tn-lamp-out" />
    </radialGradient>
    <linearGradient id="tn-ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="tn-grass-top" />
      <stop offset="1" class="tn-grass-low" />
    </linearGradient>
    <pattern id="tn-lattice" width="32" height="34" patternUnits="userSpaceOnUse" x="0" y="0">
      <path d="M0 0.75H32M0.75 0V34" class="tn-kumiko" />
    </pattern>
  </defs>

  <rect width="1600" height="900" fill="url(#tn-sky)" />
  <g class="tn-stars">{STARS.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}</g>
  <circle cx="1268" cy="150" r="150" fill="url(#tn-moonglow)" />
  <circle cx="1268" cy="150" r="44" class="tn-moon" />
  <path d="M1252 128a14 14 0 1 0 0.1 0Z M1288 168a8 8 0 1 0 0.1 0Z" class="tn-moon-mark" />

  <path class="tn-mtn-far" d="M0 500 L130 430 L250 470 L400 380 L520 450 L640 410 L780 470 L930 400 L1080 455 L1220 372 L1360 440 L1480 400 L1600 446 V900 H0Z" />
  <path class="tn-mtn-near" d="M0 560 Q180 498 360 540 T720 528 T1080 536 T1440 520 T1600 532 V900 H0Z" />

  <ellipse cx="800" cy="560" rx="760" ry="300" fill="url(#tn-houseglow)" />

  <g class="tn-house">
    <rect x="300" y="610" width="1000" height="34" class="tn-deck" />
    <rect x="300" y="644" width="1000" height="10" class="tn-deck-edge" />
    <rect x="356" y="388" width="888" height="222" class="tn-wall" />
    {BAYS.map(([x, w]) => (
      <g>
        <rect x={x} y="412" width={w} height="190" class="tn-shoji" />
        <rect x={x} y="412" width={w} height="190" fill="url(#tn-lattice)" />
      </g>
    ))}
    <rect x="784" y="404" width="24" height="206" class="tn-post" />
    {[356, 520, 656, 936, 1072, 1220].map((x) => <rect x={x} y="396" width="22" height="214" class="tn-post" />)}
    <rect x="340" y="384" width="920" height="18" class="tn-beam" />
    <path class="tn-roof" d="M232 392 Q400 368 520 300 L800 236 L1080 300 Q1200 368 1368 392 Q1376 404 1360 408 L240 408 Q224 404 232 392Z" />
    <path class="tn-roof-ridge" d="M520 300 L800 236 L1080 300" />
    <path class="tn-roof-line" d="M260 398 Q420 376 540 316 L800 258 L1060 316 Q1180 376 1340 398" />
    <rect x="752" y="214" width="96" height="16" rx="3" class="tn-beam" />
    {[332, 1252].map((x) => <rect x={x} y="654" width="16" height="40" class="tn-post" />)}
  </g>

  <path class="tn-ground" d="M0 640 Q400 668 800 664 T1600 650 V900 H0Z" fill="url(#tn-ground)" />
  <g class="tn-stones">
    <ellipse cx="800" cy="700" rx="44" ry="11" />
    <ellipse cx="784" cy="742" rx="56" ry="14" />
    <ellipse cx="812" cy="796" rx="70" ry="17" />
    <ellipse cx="780" cy="866" rx="90" ry="22" />
  </g>

  <circle cx="1238" cy="660" r="190" fill="url(#tn-lampglow)" />
  <g class="tn-lantern">
    <path d="M1196 618 L1238 590 L1280 618 Z" class="tn-stone" />
    <rect x="1208" y="618" width="60" height="44" class="tn-stone" />
    <rect x="1220" y="628" width="36" height="26" class="tn-fire" />
    <rect x="1200" y="662" width="76" height="10" class="tn-stone" />
    <rect x="1226" y="672" width="24" height="70" class="tn-stone" />
    <path d="M1196 742 H1280 L1290 758 H1186Z" class="tn-stone" />
  </g>

  <g class="tn-trees">
    <path class="tn-trunk" d="M118 900 C132 780 108 690 150 600 L172 604 C140 690 168 790 160 900Z" />
    <path class="tn-bloom" d="M-40 470 C-20 380 90 330 180 360 C250 300 360 330 360 410 C420 440 400 530 330 548 C300 610 190 620 140 584 C80 620 -10 600 -30 540 C-80 530 -80 480 -40 470Z" />
    <path class="tn-bloom-hi" d="M40 420 C80 380 150 372 190 396 C240 370 300 384 310 420 C260 412 220 430 190 440 C150 420 90 420 40 420Z" />
    <path class="tn-trunk" d="M1490 900 C1480 790 1500 700 1462 616 L1440 622 C1470 700 1450 800 1452 900Z" />
    <path class="tn-bloom" d="M1640 460 C1620 380 1520 340 1440 372 C1380 330 1290 350 1286 420 C1240 450 1262 530 1320 546 C1350 604 1440 612 1480 580 C1540 616 1620 596 1636 540 C1680 530 1680 480 1640 460Z" />
    <path class="tn-bloom-hi" d="M1560 414 C1520 380 1460 376 1430 398 C1390 376 1340 390 1330 420 C1370 414 1404 430 1430 440 C1460 422 1510 420 1560 414Z" />
  </g>
</svg>
