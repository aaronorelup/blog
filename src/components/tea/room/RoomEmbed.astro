---
// Everything that starts on a press (2.3): a game, a lab machine or a film, by its key in src/data/tea/embeds.js.
// Before a press: its poster in a window and one paper button; nothing of the thing is fetched. On a press media.js
// mounts it (an <ao-game> loaded at once, or a <video controls>) in the window or in a sheet (a <dialog>). It plays
// in the first chapter its entry names that is on the page; anywhere else the button is a link to that chapter.
import { EMBEDS, homeOf } from '../../../data/tea/embeds.js';
import { COPY } from '../../../data/tea.js';
import RoomButton from './RoomButton.astro';
import RoomLink from './RoomLink.astro';
import RoomWindow from './RoomWindow.astro';

interface Props { name: string; chapter: string; onPage: { id: string; dom: string }[] }
const { name, chapter, onPage } = Astro.props;
const e = EMBEDS[name];
if (!e) throw new Error(`src/data/tea/embeds.js: no embed named "${name}"`);
const home = homeOf(name, onPage.map((c) => c.id));
const here = home === chapter;
const to = onPage.find((c) => c.id === home);
const label = e.kind === 'film' ? COPY.room.watch : COPY.room.play;
const cost = e.mb > 5 ? `, ${COPY.room.size(e.mb)}` : '';
---
<div class="room-embed" data-room-embed={name} data-kind={e.kind} data-in={e.in} data-src={e.src} data-close={COPY.room.close}>
  <RoomWindow src={e.poster.src} alt={e.poster.alt} width={e.poster.w} height={e.poster.h} />
  {here && <RoomButton data-room-play>{label}{cost}</RoomButton>}
  {!here && to && <RoomLink href={`#${to.dom}`}>{label}</RoomLink>}
</div>
