---
// Every page's head: title and share tags, the build's commit (ao-build, which the overlay compares before mounting
// a fetched page), the self-hosted body font preloaded, and the mode set before first paint so a night visitor
// never sees a cream flash. Both layouts use it. A listed post, its notes, /about/ and the homepage also carry
// schema.org data (lib/jsonld.js), one JSON-LD block no reader sees; a noindex page none.
import FONTS from '../../data/fonts.json';
import { COMMIT } from '../../lib/build.js';
import { blogPosting, notesArticle, profilePage, scriptText, webSite } from '../../lib/jsonld.js';
import { OG } from '../../data/limits.js';
import { OWNER, SOCIAL } from '../../data/site.js';

interface Props {
  title: string;
  description: string;
  // Unlisted (soft-private) pages: keep search engines off a page that's only reachable by URL.
  noindex?: boolean;
  // A share image (site-relative path; JPG/PNG, ideally 1200x630) for link previews.
  image?: string;
  // A post's date: the page is shared as an article.
  published?: Date;
  // A post's own title, without the site's name: with its date, and unless noindex, the page carries a BlogPosting.
  headline?: string;
  // A post's voice: 'claude' where the page says Claude wrote it, and its BlogPosting then names no author.
  voice?: string;
  // The homepage: it carries the WebSite.
  home?: boolean;
  // /about/: it carries the ProfilePage.
  profile?: boolean;
  // A notes page: its post's canonical and voice, and it carries an Article (with headline).
  notesOf?: { postUrl: string; voice?: string };
  // A site path to name as canonical (and og:url) instead of the page itself (the tea room's SEO switch,
  // src/data/tea.js). Left out, as on every other page, both name the page.
  canonical?: string;
  // The page's Markdown twin (a site path), linked as an alternate unless the page is noindex. Every page links /llms.txt.
  markdown?: string;
}
const { title, description, noindex = false, image, published, headline, voice, home = false, canonical: named,
  markdown, profile = false, notesOf } = Astro.props;
const canonical = new URL(named ?? Astro.url.pathname, Astro.site).href;
const shareImage = image && new URL(image, Astro.site).href;
const data = noindex ? null
  : headline && published ? blogPosting({ headline, description, published, url: canonical, image: shareImage, voice })
  : notesOf && headline ? notesArticle({ headline, description, url: canonical, ...notesOf })
  : profile ? profilePage(canonical)
  : home ? webSite(canonical) : null;
// The X handle from the profile link the footer already shows; a card size only for the build's own cards (/og/).
const xHandle = '@' + new URL(SOCIAL.find((s) => s.label === 'X').href).pathname.split('/')[1];
const ogCard = !!shareImage && new URL(shareImage).pathname.startsWith('/og/');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={published ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
{ogCard && <meta property="og:image:width" content={String(OG.width)} />}
{ogCard && <meta property="og:image:height" content={String(OG.height)} />}
{image && <meta name="twitter:card" content="summary_large_image" />}
<meta property="og:site_name" content={OWNER.name} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:site" content={xHandle} />
{voice !== 'claude' && notesOf?.voice !== 'claude' && <meta name="twitter:creator" content={xHandle} />}
<meta name="ao-build" content={COMMIT} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Aaron Orelup · the ledger" href="/rss.xml" />
{markdown && !noindex && <link rel="alternate" type="text/markdown" href={markdown} />}
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preload" href={FONTS.preload} as="font" type="font/woff2" crossorigin />
{FONTS.faces.filter((f) => f.family === 'Zen Maru Gothic' && f.weight === 700 && f.range.startsWith('U+0000')).map((f) => <link rel="preload" href={f.file} as="font" type="font/woff2" crossorigin />)}
<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('scene-mode') === 'day') document.documentElement.dataset.mode = 'day';
    } catch (e) {}
  })();
</script>
{data && <script is:inline type="application/ld+json" set:html={scriptText(data)} />}
