---
// Every page's head: title and share tags, the build's commit (ao-build, which the overlay compares before mounting
// a fetched page), the self-hosted body font preloaded, and the mode set before first paint so a night visitor
// never sees a cream flash. Both layouts use it. A listed post and the homepage also carry schema.org data
// (lib/jsonld.js), one JSON-LD block no reader sees.
import FONTS from '../../data/fonts.json';
import { COMMIT } from '../../lib/build.js';
import { blogPosting, scriptText, webSite } from '../../lib/jsonld.js';

interface Props {
  title: string;
  description: string;
  // Unlisted (soft-private) pages: keep search engines off a page that's only reachable by URL.
  noindex?: boolean;
  // A share image (site-relative path; JPG/PNG, ideally 1200x630) for link previews.
  image?: string;
  // A post's date: the page is shared as an article.
  published?: Date;
  // A post's own title, without the site's name: with its date, and unless noindex, the page carries a BlogPosting.
  headline?: string;
  // A post's voice: 'claude' where the page says Claude wrote it, and its BlogPosting then names no author.
  voice?: string;
  // The homepage: it carries the WebSite.
  home?: boolean;
}
const { title, description, noindex = false, image, published, headline, voice, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = image && new URL(image, Astro.site).href;
const data = noindex ? null
  : headline && published ? blogPosting({ headline, description, published, url: canonical, image: shareImage, voice })
  : home ? webSite(canonical) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={published ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
{image && <meta name="twitter:card" content="summary_large_image" />}
<meta name="ao-build" content={COMMIT} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Aaron Orelup · the ledger" href="/rss.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href={FONTS.preload} as="font" type="font/woff2" crossorigin />
<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('scene-mode') === 'day') document.documentElement.dataset.mode = 'day';
    } catch (e) {}
  })();
</script>
{data && <script is:inline type="application/ld+json" set:html={scriptText(data)} />}
