---
// The day/night switch of the panel pages. Both icons are in the markup and chrome.css shows the one for the mode,
// so it is right from first paint; src/scripts/mode.js binds it.
---

<button type="button" id="mode-toggle" class="mode-toggle" aria-label="Switch between day and night">
  <span id="mode-knob" class="mode-knob">
    <svg class="mode-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#FBF3E8" stroke-width="2.1" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.4" fill="#FBF3E8" stroke="none"></circle><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"></path></svg>
    <svg class="mode-moon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 14.6A8.6 8.6 0 1 1 9.4 3.8a6.9 6.9 0 0 0 10.8 10.8Z" fill="#151726"></path></svg>
  </span>
</button>

<script>
  import '../../scripts/mode.js';
</script>
