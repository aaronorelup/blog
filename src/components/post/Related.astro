---
// Three listed posts to read next (lib/posts.js related): those sharing a project, then the topic, nearest in date.
// Icon, title and stamp each, as in Start here (ledger/PostCard).
import { listedPosts } from '../../lib/content.js';
import { related } from '../../lib/posts.js';
import PostCard from '../ledger/PostCard.astro';

const { post } = Astro.props;
const posts = related(post, await listedPosts());
---
<nav class="rel" aria-labelledby="rel-title">
  <p class="eyebrow" id="rel-title">Read next</p>
  <ol class="rel-cards">
    {posts.map((p) => <PostCard post={p} size={56} />)}
  </ol>
</nav>
