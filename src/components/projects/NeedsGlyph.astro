---
// The small line drawing before a card's needs line: what it runs on (lib/projects.js picks the name).
interface Props { name: 'browser' | 'download' | 'windows' | 'watch' | 'read' }
const PATHS = {
  browser: 'M2.5 3.5h11v9h-11zM2.5 6h11M4.5 4.8h.01M6.2 4.8h.01',
  download: 'M8 2.5v7M5 6.8 8 9.8l3-3M3 11.5v2h10v-2',
  windows: 'M2.5 3.5 7 2.9v4.6H2.5zM8.5 2.7l5-.7v5.5h-5zM2.5 8.5H7v4.6l-4.5-.6zM8.5 8.5h5V14l-5-.7z',
  watch: 'M8 2.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zM6.8 5.8v4.4L10.2 8z',
  read: 'M2.5 4c2-.8 3.8-.8 5.5.5 1.7-1.3 3.5-1.3 5.5-.5v8.5c-2-.8-3.8-.8-5.5.5-1.7-1.3-3.5-1.3-5.5-.5zM8 4.5V13',
};
const { name } = Astro.props;
---

<svg class="proj-glyph" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
  <path d={PATHS[name]} />
</svg>
