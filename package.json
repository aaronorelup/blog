{
  "name": "aaronorelup-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check/index.mjs --deploy && astro build",
    "check": "node scripts/check/index.mjs",
    "preview": "astro preview",
    "postinstall": "patch-package",
    "test": "node --test \"tests/unit/*.test.mjs\" \"src/scripts/stats/core/*.test.mjs\"",
    "new-post": "node scripts/tools/new-post.mjs",
    "never-publish:hash": "node scripts/tools/never-publish-hash.mjs",
    "media:push": "node scripts/media/push.mjs",
    "media:verify": "node scripts/media/verify.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "e2e:live": "playwright test -c tests/e2e/live.config.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "5.18.2",
    "gray-matter": "^4.0.3",
    "patch-package": "^8.0.1",
    "rehype-raw": "^7.0.0",
    "sharp": "^0.34.5",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
