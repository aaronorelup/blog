{
  "name": "aaronorelup-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check/index.mjs --deploy && astro build",
    "check": "node scripts/check/index.mjs",
    "preview": "astro preview",
    "test": "node --test \"tests/unit/*.test.mjs\" \"src/scripts/stats/core/*.test.mjs\"",
    "new-post": "node scripts/tools/new-post.mjs",
    "never-publish:hash": "node scripts/tools/never-publish-hash.mjs",
    "media:push": "node scripts/media/push.mjs",
    "media:verify": "node scripts/media/verify.mjs",
    "searches": "node scripts/tools/searches.mjs",
    "ask:eval": "node scripts/eval/run.mjs",
    "ask:judge": "node scripts/eval/judge.mjs",
    "ask:report": "node scripts/eval/report.mjs",
    "ask:compare": "node scripts/eval/compare.mjs",
    "ask:packs": "node scripts/eval/packs-compare.mjs",
    "ask:scale": "node scripts/eval/scale.mjs",
    "ask:probe": "node scripts/eval/probe.mjs",
    "ask:pin": "node scripts/tools/ask-pin.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "e2e:live": "playwright test -c tests/e2e/live.config.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "4.0.19",
    "astro": "7.4.1",
    "github-slugger": "2.0.0",
    "gray-matter": "^4.0.3",
    "rehype-raw": "^7.0.0",
    "sharp": "^0.34.5",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pagefind": "1.5.2"
  }
}
