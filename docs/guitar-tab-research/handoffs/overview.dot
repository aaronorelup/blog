  "input" -> "other" [label="3 tested / 0 docs", color="#1f2933", penwidth=1.4];
  "separation" -> "separation" [label="0 tested / 4 docs", color="#9aa5b1", style=dashed, constraint=false];
  "separation" -> "notes" [label="4 tested / 9 docs", color="#1f2933", penwidth=1.4];
