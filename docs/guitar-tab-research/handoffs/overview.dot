digraph G {
  graph [rankdir=LR, newrank=true, nodesep=0.35, ranksep=0.9, fontname="Helvetica", fontsize=18, labelloc=t, label="Guitar tab tools: stages, tool counts and edges between stages (from handoffs.json)"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#1f2933", fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  "input" [label="Input\n16 tools\nran here 6, elsewhere 0\nsteps for Aaron 0, not run 10"];
  "separation" [label="Source separation\n77 tools\nran here 17, elsewhere 2\nsteps for Aaron 17, not run 41"];
  "notes" [label="Notes and melody\n75 tools\nran here 18, elsewhere 1\nsteps for Aaron 30, not run 26"];
  "chords" [label="Chords, beat, tempo, key, tuning\n59 tools\nran here 17, elsewhere 0\nsteps for Aaron 20, not run 22"];
  "tab" [label="String and fret\n63 tools\nran here 11, elsewhere 0\nsteps for Aaron 16, not run 36"];
  "fingerstyle" [label="Voices and taps\n30 tools\nran here 5, elsewhere 0\nsteps for Aaron 11, not run 14"];
  "video" [label="Video hands and fretboard\n72 tools\nran here 17, elsewhere 0\nsteps for Aaron 10, not run 45"];
  "formats" [label="Tab file formats\n35 tools\nran here 5, elsewhere 0\nsteps for Aaron 2, not run 28"];
  "render" [label="Browser render, edit, play\n53 tools\nran here 15, elsewhere 0\nsteps for Aaron 4, not run 34"];
  "sync" [label="Metronome and sync\n34 tools\nran here 12, elsewhere 0\nsteps for Aaron 1, not run 21"];
  "corrections" [label="User corrections\n0 tools\nran here 0, elsewhere 0\nsteps for Aaron 0, not run 0", style="rounded,dashed,filled"];
  "other" [label="Hosts, runtimes, other\n61 tools\nran here 5, elsewhere 7\nsteps for Aaron 5, not run 44"];
  {rank=same; "other";}
  "input" -> "separation" [style=invis, weight=20];
  "separation" -> "notes" [style=invis, weight=20];
  "notes" -> "chords" [style=invis, weight=20];
  "chords" -> "tab" [style=invis, weight=20];
  "tab" -> "fingerstyle" [style=invis, weight=20];
  "fingerstyle" -> "video" [style=invis, weight=20];
  "video" -> "formats" [style=invis, weight=20];
  "formats" -> "render" [style=invis, weight=20];
  "render" -> "sync" [style=invis, weight=20];
  "sync" -> "corrections" [style=invis, weight=20];
  "input" -> "input" [label="1 tested / 0 docs", color="#1f2933", penwidth=1.4, constraint=false];
  "input" -> "separation" [label="1 tested / 2 docs", color="#1f2933", penwidth=1.4];
  "input" -> "notes" [label="2 tested / 3 docs", color="#1f2933", penwidth=1.4];
  "input" -> "chords" [label="1 tested / 0 docs", color="#1f2933", penwidth=1.4];
